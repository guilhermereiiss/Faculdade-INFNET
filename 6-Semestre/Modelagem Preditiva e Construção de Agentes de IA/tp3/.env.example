# Copie este arquivo para .env e preencha com a sua chave real da OpenAI.
# Nunca versione o arquivo .env nem compartilhe chaves reais em commits ou arquivos ZIP.
OPENAI_API_KEY=sk-proj-substitua-pela-sua-chave-aqui

# Opcional: defina modelo ou endpoint compatível com OpenAI (ex.: Google AI Studio / Gemini)
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_DEFAULT_MODEL=gemini-3.6-flash
